{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "nodes": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "parentId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "placement": {
            "enum": ["main", "unassigned"]
          },
          "summary": {
            "type": "string",
            "maxLength": 12000
          },
          "overview": {
            "type": "string",
            "maxLength": 500
          },
          "originalExpression": {
            "type": "string",
            "maxLength": 12000
          },
          "provenance": {
            "enum": ["user", "material", "suggestion"]
          },
          "questions": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 3000
                },
                "status": {
                  "enum": ["open", "resolved"]
                }
              },
              "required": ["id", "text", "status"]
            }
          },
          "sourceIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "maxItems": 100
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "title",
          "parentId",
          "placement",
          "summary",
          "provenance",
          "questions",
          "sourceIds",
          "createdAt",
          "updatedAt"
        ]
      }
    },
    "relations": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "source": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "target": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 3000
          },
          "status": {
            "enum": ["confirmed", "suggested"]
          }
        },
        "required": ["id", "source", "target", "label", "status"]
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "enum": [
              "book",
              "course",
              "article",
              "practice",
              "conversation",
              "other"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://",
            "maxLength": 2000
          },
          "locator": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": ["id", "title", "kind"]
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "description",
    "updatedAt",
    "nodes",
    "relations",
    "sources"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Zhixu knowledge map v1"
}
